# Environment
NODE_ENV=development

# API Configuration
# For a physical device, replace localhost with the LAN IP of the development machine.
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000

# App Configuration
EXPO_PUBLIC_APP_NAME=Badenya
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_TERMS_URL=https://badenya.naimba.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://badenya.naimba.com/privacy
EXPO_PUBLIC_SUPPORT_URL=mailto:support@badenya.app

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Features Flags
ENABLE_AI_INSIGHTS=true
ENABLE_OFFLINE_MODE=false
