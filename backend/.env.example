# Environment
NODE_ENV=development

# Server
PORT=5000
PUBLIC_API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://localhost:27017/badenya

# Demo data (development/test only)
# SEED_DEMO_PASSWORD=BadenyaDemo123!
# SEED_ALLOW_RESET=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:19006

# File Upload Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# Firebase (push notifications)
# Option 1: Service account file
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Option 2: Individual env vars
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key
# Choose a currently available model from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=your-gemini-model

# Email — Option A: SMTP (Mailgun, OVH, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@badenya.app

# Email — Option B: SendGrid (takes priority over SMTP if set)
# SENDGRID_API_KEY=SG.xxxxxxxx

# CinetPay
CINETPAY_API_KEY=your-cinetpay-api-key
CINETPAY_SITE_ID=your-cinetpay-site-id

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Use none only for a cross-site admin, with HTTPS and the trusted Origin checks.
AUTH_COOKIE_SAME_SITE=strict
APP_URL=https://badenya.naimba.com

# General API requests per IP in 15 minutes (auth endpoints have their own limits).
API_RATE_LIMIT=600
